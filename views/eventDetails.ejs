<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>CivicSync Event Details</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- NAVBAR -->
  <header class="navbar">
    <div class="nav-left">
      <img src="logo.png" alt="Logo" class="nav-logo" onclick="window.location.href='/dashboardLoggedIn'">
    </div>

    <nav>
      <a href="dashboardLoggedIn">Home</a>
      <a href="signUpEvents">Volunteer Now!</a>
      <a id="createEvent">Need Volunteers?</a>
    </nav>

    <!-- Profile dropdown -->
    <div class="profile-wrapper">
      <button class="profile-trigger">
        <div class="avatar" id="avatar-initial"></div>
        <span class="profile-email" id="display-email"></span>
        <svg class="chevron" viewBox="0 0 16 16" fill="none">
          <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="dropdown">
        <div class="dropdown-header">
          <div class="dh-email" id="header-email"></div>
        </div>

        <div class="section-label">User Information</div>

        <a class="dropdown-item" href="userProfile">
          <div>
            <div class="item-title">User Profile</div>
          </div>
        </a>

        <a class="dropdown-item" id="viewGroups">
          <div>
            <div class="item-title">User Groups</div>
          </div>
        </a>

        <a class="dropdown-item" href="viewOrganization">
          <div>
            <div class="item-title">User Organization</div>
          </div>
        </a>

        <div class="dropdown-divider"></div>

        <a class="dropdown-item sign-out" id="logoutBtn">
          <div class="item-title">Logout</div>
        </a>
      </div>
    </div>
  </header>

  <main class="container">
    <button id="backBtn" class="default-btn" style="margin: 20px;">← Back to Events</button>

    <section class="card large-card">
      <h1 id="event-name"></h1>
      <p><strong>Hosted by:</strong> <span id="event-org"></span></p>
      <p><strong>Date & Time:</strong> <span id="event-time"></span></p>
      <p><strong>Hours:</strong> <span id="event-hours"></span></p>
      <p id="event-description"></p>

      <label for="groupSelect"><strong>Select Group:</strong></label>
      <select id="groupSelect"></select>

      <button id="joinEventBtn" style="margin-top: 20px;">Join Event</button>
    </section>

    <!-- <h2>Other links for testing:</h2>
    <div class="center">
      <button id="dashboardLoggedIn" class="grey-btn">Dashboard Logged In</button>
      <button id="userProfileBtn" class="grey-btn">User Profile</button>
      <button id="viewOrganization" class="grey-btn">View Organization</button>
    </div> -->
  </main>

  <footer class="footer">
    <div>Follow Us: ● ● ● ●</div>
    <div>Contact Us: contactus@civicsync.org</div>
  </footer>

  <script type="module">
    import { handleLogout, fetchWithAuth } from "/js/auth.js";
    import { initEventDetails } from "/js/functions.js";

    document.addEventListener("DOMContentLoaded", async () => {
      await initEventDetails();
    });

    const user = await fetchWithAuth("/api/userProfileData");
    if (user && user.display_name) {
      const userEmail = user.display_name;
      document.getElementById("display-email").textContent = userEmail;
      document.getElementById("header-email").textContent = userEmail;
      document.getElementById("avatar-initial").textContent = userEmail[0].toUpperCase();
    }

    document.getElementById("backBtn").onclick = () => window.location.href = "/signUpEvents";
    document.getElementById("logoutBtn").onclick = async () => { await handleLogout(); window.location.href = "/dashboard"; };
    document.getElementById("createEvent").onclick = async () => {
      sessionStorage.setItem("openTab", "CreateEvent");
      window.location.href = "/viewOrganization";
    }
    document.getElementById("viewGroups").onclick = async () => {
      sessionStorage.setItem("openTab", "Groups");
      window.location.href = "/userProfile";
    }
    
  </script>
</body>
</html>