<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>CivicSync Group Page</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>

    <header class="navbar">
      <div class="nav-left">
        <img src="logo.png" alt="Logo" class="nav-logo" onclick="window.location.href='/dashboardLoggedIn'">
      </div>

      <nav>
        <a href="dashboardLoggedIn">Home</a>
        <a href="signUpEvents">Volunteer Now!</a>
        <a id="createEvent">Need Volunteers?</a>
      </nav>

      <!-- Profile dropdown -->
      <div class="profile-wrapper">
        <button class="profile-trigger">
          <div class="avatar" id="avatar-initial"></div>
          <span class="profile-email" id="display-email"></span>
          <svg class="chevron" viewBox="0 0 16 16" fill="none">
            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="dropdown">
          <div class="dropdown-header">
            <div class="dh-email" id="header-email"></div>
          </div>

          <div class="section-label">User Information</div>

          <a class="dropdown-item" href="userProfile">
            <div>
              <div class="item-title">User Profile</div>
            </div>
          </a>

          <a class="dropdown-item" id="viewGroups">
            <div>
              <div class="item-title">User Groups</div>
            </div>
          </a>

          <a class="dropdown-item" href="viewOrganization">
            <div>
              <div class="item-title">User Organization</div>
            </div>
          </a>

          <div class="dropdown-divider"></div>

          <a class="dropdown-item sign-out" id="logoutBtn">
            <div class="item-title">Logout</div>
          </a>
        </div>
      </div>
    </header>


    <!-- MAIN CONTENT -->
    <main class="container">

      <!-- TABS -->
      <div class="tab-vertical-container">
        <div class="tab-vertical-buttons">
          <button class="tablinks" data-tab="Profile">Group Profile</button>
          <button class="tablinks" data-tab="Members">Group members</button>
          <button class="tablinks" data-tab="Medals">Group medals</button>
        </div>

        <div class="tab-vertical-content">
          <div id="Profile" class="tabcontent">
            <h1 id="group-name">Group Name</h1>
            <section class="card large-card">
              <div class="org-layout">
                <div id="slot1" class="slot">
                    <img id="image1"/>
                </div>
                <div id="group-description" class="org-text">
                  <p>This is the group's bio, contact info, and links.</p>
                </div>
              </div>
              <button id="editGroupBtn">Edit Organization</button>

              <form id="editGroupForm" style="display:none;">
                <label>Organization Name: <input type="text" id="editGroupName" required></label><br>
                <label>Description:<br>
                  <textarea id="editGroupIntro" rows="4" cols="40"></textarea>
                </label><br>
                <button type="submit">Save</button>
                <button type="button" id="cancelEditGroupBtn">Cancel</button>
              </form>
            </section>

          </div>

          <div id="Members" class="tabcontent">
            <h3>Members</h3>
            <div id="members-container" class="card-container">
                <div class="card placeholder"><p>No members yet.</p></div>
            </div>
          </div>

          <div id="Medals" class="tabcontent">
            <h3>Medals</h3>
            <div id="medals-container" class="card-container">
                <div class="card placeholder"><p>No medals yet.</p></div>
            </div>
          </div>
        
        </div>
      
      </div>

    </main>

    <!-- TODO: Add a working email to contact, and links to any social media pages we create-->
    <footer class="footer">
      <div>Follow Us ● ● ● ●</div>
      <div>Contact Us: email@email.com</div>
    </footer>

    <script type="module" src="/js/functions.js"></script>
    <script type="module">
      import { handleLogout, fetchWithAuth } from "/js/auth.js";
      import { fetchGroup,fetchMembersMedals} from "/js/functions.js";

        document.addEventListener("DOMContentLoaded", async () => {

        const openTab = sessionStorage.getItem("openTab");
        if (openTab) {
          sessionStorage.removeItem("openTab");
          const tabBtn = document.querySelector(`.tab-vertical-buttons button[data-tab="${openTab}"]`);
          if (tabBtn) tabBtn.click();
        }
        
        // Initial page load
        await fetchGroup(fetchWithAuth, localStorage.getItem('groupViewId'));
        await fetchMembersMedals(fetchWithAuth, localStorage.getItem('groupViewId'));

        const user = await fetchWithAuth("/api/userProfileData");
        if (user && user.display_name) {
          const userEmail = user.display_name;
          document.getElementById("display-email").textContent = userEmail;
          document.getElementById("header-email").textContent = userEmail;
          document.getElementById("avatar-initial").textContent = userEmail[0].toUpperCase();
        }

        document.getElementById("logoutBtn").onclick = async () => {
          await handleLogout();
          window.location.href = "/dashboard";
        };

        document.getElementById("createEvent").onclick = async () => {
          sessionStorage.setItem("openTab", "CreateEvent");
          window.location.href = "/viewOrganization";
        }

        document.getElementById("viewGroups").onclick = async () => {
          sessionStorage.setItem("openTab", "Groups");
          window.location.href = "/userProfile";
        }
        
      });
      
    </script>
  </body>
</html>
