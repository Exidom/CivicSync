<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>CivicSync Logged In Home Page</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- NAVBAR -->
  <header class="navbar">
    <div class="nav-left">
      <img src="logo.png" alt="Logo" class="nav-logo" style="cursor: default;">
    </div>

    <nav>
      <a>Home</a>
      <a href="signUpEvents">Volunteer Now!</a>
      <a id="createEvent">Need Volunteers?</a>
    </nav>

    <!-- Profile dropdown -->
    <div class="profile-wrapper">
      <button class="profile-trigger">
        <div class="avatar" id="avatar-initial"></div>
        <span class="profile-email" id="display-email"></span>
        <svg class="chevron" viewBox="0 0 16 16" fill="none">
          <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="dropdown">
        <div class="dropdown-header">
          <div class="dh-email" id="header-email"></div>
        </div>

        <div class="section-label">User Information</div>

        <a class="dropdown-item" href="userProfile">
          <div>
            <div class="item-title">User Profile</div>
          </div>
        </a>

        <a class="dropdown-item" id="viewGroups">
          <div>
            <div class="item-title">User Groups</div>
          </div>
        </a>

        <a class="dropdown-item" href="viewOrganization">
          <div>
            <div class="item-title">User Organization</div>
          </div>
        </a>

        <div class="dropdown-divider"></div>

        <a class="dropdown-item sign-out" id="logoutBtn">
          <div class="item-title">Logout</div>
        </a>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="container-dashboard">

    <div class="hero-banner">
      <h1>Welcome to CivicSync</h1>
      <p>Get started by finding the right group for you</p>
    </div>

    <div class="dashboard-body">

      <div class="membership-card" style="min-width: 1200px; margin: auto;">
        <div class="membership-left">
          <h2>Manage your membership</h2>
          <p>Update your profile, groups, and organization details</p>
        </div>
        <button id="signUpBtn" class="edit-profile-btn" 
          onclick="window.location.href = '/userProfile'">Edit Profile</button>
      </div>

      <div class="stories-section">
        <div class="section-header">
          <h3>Success Stories</h3>
          <div class="section-line"></div>
        </div>
        <div class="stories-list">
          <section class="story-card">
            <div class="org-image">
              <img src="successStory1.jpg" alt="Community Garden" class="success-img">
            </div>
            <div class="org-text">
              <strong>Community Garden Revival</strong>
              <p>
                Here at CivicSync we help a wide variety of service organizations to connect 
                with volunteers and motivate them to participate more often. One of these 
                organizations reached out to us asking for help with scheduling events for 
                their garden revival project. After getting their community members signed up 
                on our site and added to their common group, they created weekly events and 
                were able to make significant progress towards revitalizing their garden. 
                Member's individual service hours were recorded and posted to their group's
                leaderboard to provide an additional sense of competition for future events.
              </p>
            </div>
          </section>
          <section class="story-card">
            <div class="org-image">
              <img src="successStory2.jpg" alt="Coding Workshop" class="success-img">
            </div>
            <div class="org-text">
              <strong>Youth Coding Workshop</strong>
              <p>
                This organization contacted us to help organize their youth coding workshop. 
                They began by creating their group and organization account, and then created 
                their event. They then told the parents of the participants how to sign up 
                on our website, and provided them with the access code of their group so that 
                they could start applying for the event. The organizers appreciated how easy 
                the website was to use, and said that they "would love to use the website for
                next year's workshop."
              </p>
            </div>
          </section>
          <section class="story-card">
            <div class="org-image">
              <img src="successStory3.jpg" alt="River Cleanup" class="success-img">
            </div>
            <div class="org-text">
              <strong>Riverside Park Cleanup</strong>
              <p>
                This organization reached out for help with organizing their river and park  
                cleanup project. After creating their org account and weekly events, they   
                informed their members of the sign up process and quickly had a full list  
                of applications. They soon realized that they were getting more volunteer 
                applications than they had organization members. After the event, we were told 
                that they "never could have expected to receive as much help from the community 
                as they had."
              </p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>

  <!-- TODO: Add a working email to contact, and links to any social media pages we create-->
  <footer class="footer">
    <div>Follow Us: ● ● ● ●</div>
    <div>Contact Us: contactus@civicsync.org</div>
  </footer>

  <script type="module">
    import { handleLogout, fetchWithAuth } from "/js/auth.js";
    const user = await fetchWithAuth("/api/userProfileData");
        if (user && user.display_name) {
          const userEmail = user.display_name;
          document.getElementById("display-email").textContent = userEmail;
          document.getElementById("header-email").textContent = userEmail;
          document.getElementById("avatar-initial").textContent = userEmail[0].toUpperCase();
        }
    // document.getElementById("userName").innerText = user.name;
    // document.getElementById("userPic").src = user.picture;
    // TODO: Need to get user info to appear by profile picture!

    // Logout Button
    document.getElementById("logoutBtn").onclick = async () => {
        await handleLogout();
        window.location.href = "/dashboard";
    };
    if (!user.hasOrg) {
      document.getElementById("createEvent").onclick = async () => {
      window.location.href = "/viewOrganization";
      }
    }
    else {
      document.getElementById("createEvent").onclick = async () => {
        sessionStorage.setItem("openTab", "CreateEvent");
        window.location.href = "/viewOrganization";
      }
    }

    document.getElementById("viewGroups").onclick = async () => {
      sessionStorage.setItem("openTab", "Groups");
      window.location.href = "/userProfile";
    }

  </script>
</body>
</html>
